{
  "realm": "eventra",
  "enabled": true,
  "registrationAllowed": true,
  "roles": {
    "realm": [
      { "name": "USER" },
      { "name": "SCANNER" },
      { "name": "EVENT_MANAGER" },
      { "name": "ADMIN" },
      { "name": "SERVICE" }
    ]
  },
  "clients": [
    {
      "clientId": "eventra-cli",
      "name": "Eventra local CLI",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:8080/*"],
      "webOrigins": ["http://localhost:8080"]
    }
  ]
}
